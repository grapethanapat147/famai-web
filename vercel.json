{
  "crons": [
    { "path": "/api/cron/aged-stock", "schedule": "0 2 * * *" },
    { "path": "/api/cron/registration-overdue", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
