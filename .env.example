# ก๊อปไฟล์นี้เป็น .env.local แล้วเติมค่า — .env / .env.local อยู่ใน .gitignore แล้ว
# ค่าจริงและคำอธิบายอยู่ใน docs/06-supabase-setup.md

# ── เปิดเผยได้ อยู่ในหน้าเว็บอยู่แล้ว ────────────────────────────────
# ความปลอดภัยมาจาก RLS ที่ฐานข้อมูล ไม่ได้มาจากการซ่อนคีย์นี้
NEXT_PUBLIC_SUPABASE_URL=https://hpsmjavfvrdctclmlmhp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── ห้ามหลุดเด็ดขาด ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ─────────────────────
# คีย์นี้ข้ามผ่าน RLS ทุกข้อ ใครได้ไปอ่านและแก้ข้อมูลทุกสาขาได้ทั้งหมด
# ห้าม commit · ห้ามใส่ในหน้าเว็บ · ห้ามส่งทางแชต
SUPABASE_SERVICE_ROLE_KEY=

# ── ต่อฐานข้อมูลตรง (migration / งานตามเวลา) ────────────────────────
DATABASE_URL=

# ── LINE Messaging API (Phase 2) ───────────────────────────────────
# แพ็กฟรีส่งได้ 300 ข้อความ/เดือน เกินแล้วต้องขึ้นแพ็ก Basic
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
